# ========= FTP 影片來源 =========
FTP_HOST=192.168.1.10
FTP_PORT=21
FTP_USER=anonymous
FTP_PASSWORD=
# 是否使用 FTPS (explicit TLS)
FTP_TLS=false
# 被動模式 (大多數情況維持 true)
FTP_PASSIVE=true
# FTP 伺服器檔名編碼: utf-8 / gbk / big5 / latin-1
FTP_ENCODING=utf-8
# 連線 timeout (秒)
FTP_TIMEOUT=20

# 影片根目錄，可多個用 ; 分隔。格式: 路徑|類型  (類型= movie / tv / auto)
# 例: /Movies|movie;/TVShows|tv;/Downloads|auto
LIBRARY_ROOTS=/|auto

# ========= TMDB 刮削 =========
# 免費申請: https://www.themoviedb.org/settings/api  (v3 API Key)
TMDB_API_KEY=
TMDB_LANGUAGE=zh-TW
# 刮不到中文時退回英文簡介
TMDB_FALLBACK_LANGUAGE=en-US
# 每秒最多幾次 TMDB 請求
TMDB_RATE_LIMIT=8

# ========= 播放 / 轉碼 =========
# ffmpeg / ffprobe 路徑 (若已在 PATH 可留空)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# HLS 每段秒數
HLS_SEGMENT_SECONDS=6
# 轉碼硬體加速: auto / none / nvenc / qsv / amf / videotoolbox
# auto = 啟動時實際試編一小段，依序測 nvenc -> qsv -> amf，哪個真的能用就用哪個
FFMPEG_HWACCEL=auto
# 解碼加速，跟上面是不同的硬體單元。auto = ffmpeg 自己挑、失敗自動退回 CPU
# 舊顯卡常見「編碼被驅動擋掉、但解碼還能用」，那時這一項就很有價值
# 實測發現軟體濾鏡要用畫格時，GPU→CPU 搬運常比省下的解碼還貴（GTX 1070 上慢 30%）。
# 開之前先跑 /api/diagnostics/bench/<file_id> 量過再決定。
FFMPEG_DECODE_HWACCEL=none
# 轉碼畫質 (CRF, 越小越好越大檔; nvenc/qsv 會換算成 cq)
TRANSCODE_CRF=21
# 轉碼上限解析度高度 (0 = 不縮放)
TRANSCODE_MAX_HEIGHT=1080
# 預先產生後面幾段 (讓播放更順)
HLS_PREFETCH_SEGMENTS=3
# 但轉碼速度低於這個倍數就自動停止預轉 —— 多開的 ffmpeg 會跟使用者正在等的那段搶 CPU
PREFETCH_MIN_SPEED=1.5
# 分段快取上限 (MB)
HLS_CACHE_MAX_MB=4096

# ========= 登入驗證 =========
# 要對外開放前務必打開。沒開的話，任何連得到這個位址的人都能看你整個媒體庫。
AUTH_ENABLED=false
# 管理員密碼（AUTH_ENABLED=true 時必填）。這組是完整權限。
AUTH_PASSWORD=
# 唯讀密碼。用這組登入的人只能瀏覽與播放，不能下載原始檔、不能瀏覽 FTP 目錄、
# 不能觸發掃描或清快取。要分享給別人看片就給這一組。留空 = 不開放唯讀登入。
# 兩組密碼一定要不一樣。
VIEWER_PASSWORD=
# 留空會自動產生並存在 data/secret.key；自己填的話換機器也能共用同一組 session
AUTH_SECRET=
# 提醒：改掉上面任何一組密碼，用那組密碼登入的既有 session 會自動失效
# （密碼指紋有納入 token 簽章）。想在不改密碼的情況下把所有人踢掉，
# 用管理員身分打 POST /api/session/revoke-all。
# 登入後多久要重新登入（天）
SESSION_DAYS=30

# ========= 遠端畫質 =========
# 判斷來源 IP：區網(含 10./172.16./192.168.)算本地，其餘算遠端。
# 家用光纖「上傳」通常遠小於下載，所以遠端預設降畫質並鎖住峰值位元率。
REMOTE_MAX_HEIGHT=720
REMOTE_BITRATE_KBPS=2800
# 區網要不要也鎖位元率，0 = 不鎖
LAN_BITRATE_KBPS=0

# 轉碼輸出的聲道數。預設 2 = 一律降混成立體聲，相容性最好。
# 多聲道 AAC 包在 mpegts 裡，各家瀏覽器與 hls.js 的支援度並不一致，
# 所以就算片源是 5.1，預設也會降成立體聲。
# 家裡有環繞喇叭、確定播得動的話設 6 保留 5.1；設 0 = 完全不動原始聲道。
# 改過之後舊的快取分段聲道數會不一樣，服務會自動用不同的快取路徑，不必手動清。
AUDIO_CHANNELS=2
AUDIO_BITRATE_KBPS=192

# ---- 對外開放前務必檢查 ----
# session cookie 只在 HTTPS 下送出。走 Cloudflare Tunnel 或任何反向代理時
# 一定要開，否則只要有一次 http 連線，session token 就明文上線。
COOKIE_SECURE=false

# 只在前面確實有反向代理（cloudflared / nginx）時才開。
# 開了之後，來源位址會採用 CF-Connecting-IP 或 X-Forwarded-For 最右邊那段；
# 而且只有當連線本身來自 loopback/內網（也就是真的是自家 proxy）才採信，
# 公網直連的人送什麼標頭都不算數。
TRUST_PROXY=false
# 額外算「本地」的網段，逗號分隔。用 Tailscale 又想維持原畫質的話填 100.64.0.0/10
LOCAL_NETWORKS=

# ========= 伺服器 =========
HOST=0.0.0.0
PORT=8080
# 小於這個大小 (MB) 的影片檔會被忽略，避免收錄預告片/樣本檔
MIN_FILE_MB=50
# 掃描時同時探測影片資訊的併發數
PROBE_CONCURRENCY=3
# 啟動時自動掃描
AUTO_SCAN_ON_START=false
# 開發用：改動 app/ 底下的程式時自動重啟服務（不用手動 Ctrl+C 再啟動一次）
DEV_RELOAD=false
