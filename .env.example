# ========= FTP 影片來源 =========
FTP_HOST=192.168.1.10
FTP_PORT=21
FTP_USER=anonymous
FTP_PASSWORD=
# 是否使用 FTPS (explicit TLS)
FTP_TLS=false
# 被動模式 (大多數情況維持 true)
FTP_PASSIVE=true
# FTP 伺服器檔名編碼: utf-8 / gbk / big5 / latin-1
FTP_ENCODING=utf-8
# 連線 timeout (秒)
FTP_TIMEOUT=20

# 影片根目錄，可多個用 ; 分隔。格式: 路徑|類型  (類型= movie / tv / auto)
# 例: /Movies|movie;/TVShows|tv;/Downloads|auto
LIBRARY_ROOTS=/|auto

# 片庫在同一台機器上時的捷徑（FTP 路徑 = 本機路徑，分號分隔多組）。
# 沒設就照舊走 FTP —— 別台機器掛遠端 FTP 時就是靠這個 fallback。
# 設了之後轉碼與掃描直接讀檔，省掉「HTTP → FastAPI → FTP → 磁碟」四層搬運。
# 這一項是路徑，會擴大服務讀得到的範圍，所以只能放這裡，不進後台 UI。
#   例：LIBRARY_LOCAL_ROOTS=/=D:\1.FTP
LIBRARY_LOCAL_ROOTS=

# ========= TMDB 刮削 =========
# 免費申請: https://www.themoviedb.org/settings/api  (v3 API Key)
TMDB_API_KEY=
TMDB_LANGUAGE=zh-TW
# 刮不到中文時退回英文簡介
TMDB_FALLBACK_LANGUAGE=en-US
# 每秒最多幾次 TMDB 請求
TMDB_RATE_LIMIT=8

# ========= 播放 / 轉碼 =========
# ffmpeg / ffprobe 路徑 (若已在 PATH 可留空)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# HLS 每段秒數
HLS_SEGMENT_SECONDS=6
# 兩階 HLS：多發一個「上階」，內容是原檔直接 remux（-c:v copy）。
# 區網 → 只發上階：畫質等於原檔，播放全程不會啟動任何 ffmpeg（零轉碼）。
# 遠端 → 上階排在轉碼階梯最前面，讓播放器按緩衝水位自己選（上階峰值實測
#        21.7 Mbps，一般外網選不到，ABR 會自己落到轉碼那幾階）。
# 只有 h264 ＋ 已掃過 keyframe 邊界表 ＋ keyframe 間距 < 分段長度的片源才有
# 上階，其餘照舊只發轉碼階、行為完全不變。
# 邊界表是每檔約 30 秒的一次性成本（全庫 408 GB 約 42 分鐘），由背景佇列在
# 掃描結束後慢慢補；開播遇到還沒算好的檔案不會等它，那一次照舊發轉碼階。
# 某一段 remux 失敗會把整個檔案的上階下線改發轉碼階，播放不中斷。
# 預設 false —— 它改的是播放路徑，開之前先在實機播一次。
HLS_TWO_RUNG=false
# 轉碼硬體加速: auto / none / nvenc / qsv / amf / videotoolbox
# auto = 啟動時實際試編一小段，依序測 nvenc -> qsv -> amf，哪個真的能用就用哪個
FFMPEG_HWACCEL=auto
# 解碼加速，跟上面是不同的硬體單元。auto = ffmpeg 自己挑、失敗自動退回 CPU
# 舊顯卡常見「編碼被驅動擋掉、但解碼還能用」，那時這一項就很有價值
# 實測發現軟體濾鏡要用畫格時，GPU→CPU 搬運常比省下的解碼還貴（GTX 1070 上慢 30%）。
# 開之前先跑 /api/diagnostics/bench/<file_id> 量過再決定。
FFMPEG_DECODE_HWACCEL=none
# 轉碼畫質 (CRF, 越小越好越大檔)。VMAF 量測後從 21 改成 17：
# CRF 21 在 1080p 片源上只吐 1,093 kbps／VMAF 92.2，把該花的碼率省掉了。
# 只在必須重編、而且走 CPU 時才有作用（硬體編碼看下面的 NVENC_CQ）。
TRANSCODE_CRF=17
# NVENC 專用的品質參數。**不要跟 TRANSCODE_CRF 用同一個數字** ——
# 實測 -cq 21 讓 NVENC 吐出 10.2 Mbps（原檔 10.9），幾乎等於沒壓縮。
# NVENC 的 cq 刻度比 x264 的 crf 鬆很多。VMAF 量測後定在 25：
# 4K→1080p 到 95.6／3,185 kbps、1080p 到 93.9／5,613 kbps，兩邊都在上限之內。
# 注意：有目標碼率時（遠端）走的是碼率導向，這個值不會生效 —— 它服務的是
# 「沒有鎖碼率」的那條路（區網重編）。
NVENC_CQ=25
# 轉碼上限解析度高度 (0 = 不縮放)
TRANSCODE_MAX_HEIGHT=1080
# 走 CPU 編碼時的 x264 preset。越快畫質越差、檔越大；
# ultrafast / superfast / veryfast / faster / fast / medium / slow
# 轉碼跟不上播放（速度倍數 < 1）就往快的調。硬體編碼時這一項無效。
# VMAF 量測後從 veryfast 改成 medium：同一個 CRF 下多 2.1 分，只多花 9% 碼率，
# 而 3.14x 對 1080p 仍然夠。veryfast 在同碼率下輸給 NVENC 與 medium 兩者。
X264_PRESET=medium
# HDR 片源要不要轉成 SDR。不轉的話在一般螢幕上會灰灰的、顏色很淡。
# auto = 偵測到 HDR（PQ / HLG）才轉，其餘不動；true = 一律轉；false = 都不轉。
# 這是軟體濾鏡，會吃 CPU，而且跟硬體解碼併用時要多一次 GPU→CPU 搬運。
HDR_TONEMAP=auto
# 色調映射演算法：hable（預設，明暗兼顧）/ mobius（保色，亮部較容易過曝）
# / reinhard（最快，對比最平）/ bt2390（最貼近標準，最慢）
HDR_TONEMAP_ALGO=hable
# 預先產生後面幾段 (讓播放更順)
HLS_PREFETCH_SEGMENTS=3
# 但轉碼速度低於這個倍數就自動停止預轉 —— 多開的 ffmpeg 會跟使用者正在等的那段搶 CPU
PREFETCH_MIN_SPEED=1.5
# 分段快取上限 (MB)
HLS_CACHE_MAX_MB=4096

# ========= 登入驗證 =========
# 要對外開放前務必打開。沒開的話，任何連得到這個位址的人都能看你整個媒體庫。
AUTH_ENABLED=false
# 管理員密碼（AUTH_ENABLED=true 時必填）。這組是完整權限。
AUTH_PASSWORD=
# 唯讀密碼。用這組登入的人只能瀏覽與播放，不能下載原始檔、不能瀏覽 FTP 目錄、
# 不能觸發掃描或清快取。要分享給別人看片就給這一組。留空 = 不開放唯讀登入。
# 兩組密碼一定要不一樣。
VIEWER_PASSWORD=
# 留空會自動產生並存在 data/secret.key；自己填的話換機器也能共用同一組 session
AUTH_SECRET=
# 提醒：改掉上面任何一組密碼，用那組密碼登入的既有 session 會自動失效
# （密碼指紋有納入 token 簽章）。想在不改密碼的情況下把所有人踢掉，
# 用管理員身分打 POST /api/session/revoke-all。
# 登入後多久要重新登入（天）
SESSION_DAYS=30

# ========= Google 登入（可選，但對外開放時最推薦） =========
# 設好之後，登入頁會多一顆「使用 Google 帳號登入」，密碼登入仍然保留。
# 只填這一段、不設 AUTH_PASSWORD 的話，就是純 Google 帳號制。
#
# 申請步驟：
#   1. https://console.cloud.google.com/ → 建立專案
#   2. 「API 和服務 → OAuth 同意畫面」建立，User type 選「外部」，
#      發布狀態按「發布應用程式」（測試中狀態只有測試使用者能登入，而且會過期）
#   3. 「API 和服務 → 憑證 → 建立憑證 → OAuth 用戶端 ID → 網頁應用程式」
#   4. 「已授權的重新導向 URI」填下面 PUBLIC_BASE_URL 加上 /auth/google/callback
#      Google 只接受 https（http://localhost 例外），純 IP 位址一律不接受，
#      而且必須「一字不差」，結尾多一個斜線都不行。
#   5. 把用戶端 ID 與密鑰貼到下面兩行
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 對外網址，含 https://，結尾不要斜線。回呼網址由它自動組出來。
PUBLIC_BASE_URL=
# 回呼網址想自己指定才填這一行，通常留空即可
GOOGLE_REDIRECT_URI=
# 第一個管理員。這裡列到的 email 一登入就是管理員且免審核 ——
# 沒設的話所有人都會卡在「待審核」而沒有人有權限核准。逗號分隔可多個。
GOOGLE_ADMIN_EMAILS=
# 只允許這些網域的 Google 帳號申請，逗號分隔。留空 = 任何 Google 帳號都能送出申請
# （送出不等於進得來，預設仍要管理員核准）。
GOOGLE_ALLOWED_DOMAINS=
# 新帳號自動核准（角色仍是唯讀）。對外開放時建議維持 false。
GOOGLE_AUTO_APPROVE=false

# ========= 使用者資料存哪裡 =========
# 下面三個都填了就存 MSSQL 的 dbo.filmax_users，否則存本機 SQLite 的 app_user。
#
# 接 MSSQL 之前要做的三件事：
#   1. Windows 裝 Microsoft ODBC Driver 18 for SQL Server（不是 SQL Server 本身）
#   2. pip install pyodbc
#   3. 跑一次 db\migrate.bat 套用 Flyway 遷移（V1～V5），把資料表建起來
# 設好之後跑 db\檢查連線.bat，它會逐項告訴你卡在哪一關。
#
# 注意：**沒有「連不上就自動退回 SQLite」這種行為**。那會變成兩份使用者資料
# 各說各話 —— 在 A 核准的人在 B 不存在，而且沒有人會發現自己正在用哪一份。
# 設定了就是要用它，連不上就明講連不上。
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=filmax
MSSQL_USER=filmax_app
MSSQL_PASSWORD=
# 名稱要跟「ODBC 資料來源管理員」裡看到的一字不差（含空格與大小寫）
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 起預設就要求加密。內網自簽憑證的伺服器要把 TRUST_CERT 設 true，
# 否則會卡在憑證驗證失敗。對外的正式環境不要打開。
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=false
MSSQL_TIMEOUT=10
# 上面全部不管，直接給一整串 ODBC 連線字串
MSSQL_ODBC_DSN=

# ---- 明講要用哪一份 ----
# 留空 = 自動判斷（上面 MSSQL 有設好就走 MSSQL，否則 SQLite）。
# 填了就是命令，跟自動判斷不一致時以這裡為準，連不上就直接報錯不會偷偷退回。
# 合法值只有 sqlite 或 mssql，打錯字會在啟動時就被擋下來，不會安靜地走預設。
USER_STORE=
# 媒體庫（影片、集數、相片）存哪裡。**預設一律 sqlite**，就算 MSSQL 設好了也一樣 ——
# 媒體庫資料量比使用者大好幾個數量級，要搬過去必須自己明講 MEDIA_STORE=mssql。
MEDIA_STORE=

# ========= 遠端畫質 =========
# 判斷來源 IP：區網(含 10./172.16./192.168.)算本地，其餘算遠端。
# 家用光纖「上傳」通常遠小於下載，所以遠端預設降畫質並鎖住峰值位元率。
REMOTE_MAX_HEIGHT=720
# VMAF 量測後從 2800 改成 8000：必須重編的片源到 VMAF 95 需要 NVENC 2800k／
# x264 4000k，而邊際增益掉到 0.5 以下是在 8000k —— 再往上加買不到畫質
# （8000→12000 只有 +0.3～+0.4）。這是天花板，不是目標。
REMOTE_BITRATE_KBPS=8000
# 區網要不要也鎖位元率，0 = 不鎖
LAN_BITRATE_KBPS=0
# 遠端階梯上面要不要多發一階更高解析度（給大螢幕用）。
# **只放寬解析度，不放寬碼率** —— 上傳頻寬由 REMOTE_BITRATE_KBPS 封頂，
# 解析度上限只決定畫面多大。同樣吃 8000 kbps，1080p 在電腦螢幕上比 720p
# 清楚得多；網路不夠的手機 ABR 會自己降回 REMOTE_MAX_HEIGHT 那一階，
# 所以開著不會讓手機變卡。上限同時受 TRANSCODE_MAX_HEIGHT 與片源本身壓住。
# 使用者在畫質選單手動挑過的話不會加這一階（挑的那一檔就是他要的上限）。
REMOTE_HIGH_RUNG=true
# 遠端可以走「直接串流」的片源位元率上限（kbps）。超過就改走 HLS。
# **direct 沒有畫質階梯** —— 鏈路餵不動時它不會變模糊，它會停住。所以判斷
# 只能看片源餵不餵得動，不能看「有沒有 remux 上階」（那講的是改走 HLS 會不會
# 掉畫質，是另一件事）。有上階時改走 HLS 畫質完全一樣；沒有上階時會重編，
# 畫質有損，但代價是「降一階」而不是「播不動」。0 = 不檢查。
# 使用者在面板上手動按「試試直接播放」時不受這一項限制（卡住仍會自動切回）。
#
# **這個值要照「單條連線」的實測填，不是照對外總頻寬。**（量測 2026-09-11）
#
#   本機磁碟讀取                    ~1,035 Mbps   ← 不是瓶頸
#   這台機器上傳到 Cloudflare 邊緣   ~220-310 Mbps ← 也不是瓶頸
#   經 PUBLIC_BASE_URL 單條連線       ~7.3 Mbps   ← **播放器拿到的就是這個**
#                        3 條並行     ~16 Mbps
#                        6 條並行     ~33 Mbps
#                       12 條並行     ~42 Mbps
#
# 對外總頻寬有 200 Mbps 以上，但**單條 TCP 只跑得到 7 Mbps** —— 差距是
# 通道那一段的 per-connection 限制（RTT × 視窗），不是頻寬不夠。而播放器
# 抓一段影片就是一條連線，所以它拿得到的是 7 不是 200。照 200 設這個值
# 等於讓每一部大檔都去賭一條餵不動的線。
#
# 4000 = 單條實測 7.3 Mbps 的一半多一點。留一半餘裕是因為量到的是「這一刻、
# 這條線路」，而遠端手機在 4G／訊號不好的地方只會更低，不會更高。
REMOTE_DIRECT_MAX_KBPS=4000

# ---- 串流量測（診斷用，J 章第 7 節）----
# 把搬運吞吐、HLS 分段快取命中率與 ffmpeg 速度記在記憶體裡（固定筆數的
# 環形緩衝，幾百筆數字、KB 級）。看 /api/diagnostics/stream。
# **沒有它的話「手機卡頓」只能用猜的** —— 慢在 FTP、慢在 ffmpeg、還是慢在
# 客戶端，這三種的處方完全不同。極低階機器才需要關。
STREAM_DIAG=true
# 原始位元組串流（direct／下載／相片／PDF）一次搬多少 KiB。
# **不要憑感覺調。**看到 256 就改成 4096 然後宣稱效能修好了，那是把運氣
# 當證據。先看 /api/diagnostics/stream 的 ftp_mbps，確認瓶頸真的在搬運層。
STREAM_CHUNK_KB=256

# 轉碼輸出的聲道數。預設 2 = 一律降混成立體聲，相容性最好。
# 多聲道 AAC 包在 mpegts 裡，各家瀏覽器與 hls.js 的支援度並不一致，
# 所以就算片源是 5.1，預設也會降成立體聲。
# 家裡有環繞喇叭、確定播得動的話設 6 保留 5.1；設 0 = 完全不動原始聲道。
# 改過之後舊的快取分段聲道數會不一樣，服務會自動用不同的快取路徑，不必手動清。
AUDIO_CHANNELS=2
AUDIO_BITRATE_KBPS=192

# ---- 對外開放前務必檢查 ----
# session cookie 只在 HTTPS 下送出。走 Cloudflare Tunnel 或任何反向代理時
# 一定要開，否則只要有一次 http 連線，session token 就明文上線。
COOKIE_SECURE=false

# 走 Cloudflare Tunnel 時，HOST 一定要改成 127.0.0.1（見下面「伺服器」段），
# 只讓同機的 cloudflared 連得到；留 0.0.0.0 的話區網裡的人可以繞過 Cloudflare 直連。
#
# 只在前面確實有反向代理（cloudflared / nginx）時才開。
# 開了之後，來源位址會採用 CF-Connecting-IP 或 X-Forwarded-For 最右邊那段；
# 而且只有當連線本身來自 loopback/內網（也就是真的是自家 proxy）才採信，
# 公網直連的人送什麼標頭都不算數。
TRUST_PROXY=false
# 額外算「本地」的網段，逗號分隔。用 Tailscale 又想維持原畫質的話填 100.64.0.0/10
LOCAL_NETWORKS=

# ========= 伺服器 =========
HOST=0.0.0.0
PORT=8080
# 小於這個大小 (MB) 的影片檔會被忽略，避免收錄預告片/樣本檔
MIN_FILE_MB=50

# 掃描時要略過的資料夾，比對「名稱開頭」，逗號分隔，大小寫不分。
# 例：SCAN_EXCLUDE_DIR_PREFIXES=_,temp,備份
#   → _old、_tmp、TempFiles、備份2024 都會整個跳過，連同底下所有子目錄。
# 比的是資料夾名稱不是完整路徑，所以放在哪一層都有效。
# 整棵子樹都不會被走訪，省下的是列目錄的時間，不只是過濾檔案。
SCAN_EXCLUDE_DIR_PREFIXES=

# 這些資料夾底下不套用 MIN_FILE_MB 的大小門檻，多小的影片都收。
# 比對規則跟上面完全一樣：比名稱開頭、大小寫不分、放在哪一層都有效、含子資料夾。
# 只比目錄名，不比檔名。
# 用途：某個目錄裡就是放短片，但不希望為了它把全庫的門檻降低 ——
# 門檻降低會把手機錄的短片之類全部拉進來（實測某座片庫是 99.4% 的雜訊）。
SCAN_MIN_SIZE_EXEMPT_DIRS=

# 掃描時要略過的副檔名，逗號分隔。大小寫不分，加不加點都可以。
# 例：SCAN_EXCLUDE_EXTS=iso,ts,m2ts  跳過藍光原盤與錄影檔
SCAN_EXCLUDE_EXTS=
# 只收錄這些副檔名，留空 = 不限制。
# 兩個都設的時候，排除清單優先 —— 同一個副檔名兩邊都寫到就是不收。
SCAN_ONLY_EXTS=

# ---- JAV 刮削（番號類作品）----
# TMDB 查不到番號（`SSIS-938` 丟進去只會是 failed），所以這類作品另走一組來源：
# javbus / fc2 / d2pass / jav321。實作是 import OpenAver 已經寫好的爬蟲
# （https://github.com/slive777/OpenAver），不是自己重寫。
#
# 指到 OpenAver 的 app 目錄。留空 = 停用，所有東西照舊全部走 TMDB。
# 不需要另外開 OpenAver 那個桌面程式 —— 這裡是直接 import 它的模組。
OPENAVER_PATH=

# 這些資料夾底下的影片走 JAV 刮削。比對規則跟 SCAN_EXCLUDE_DIR_PREFIXES
# 完全一樣：比名稱開頭、大小寫不分、放在哪一層都有效、含子資料夾。
# 目錄命中之後還要真的解得出番號才算，所以同一個目錄裡混著沒有番號的檔案
# （預告、寫真附帶的短片）不會被誤判 —— 那些照舊走 TMDB。
# 例：SCAN_JAV_DIRS=99.Private
SCAN_JAV_DIRS=

# 這些資料夾底下、檔名是 20211002_213546+0800 這種格式的影片會歸到「錄影」
# 分類（kind=home）：標題自動變成可讀日期、年份從檔名取、不去刮 TMDB。
# 比對規則跟 SCAN_EXCLUDE_DIR_PREFIXES 一樣：比名稱開頭、大小寫不分、含子資料夾。
#
# 為什麼不靠目錄名分年：實測這座片庫的 `手機照片/20230219/iPhone培` 底下 40 個
# 檔案，實際年份是 2019×1、2022×38、2023×1 —— 目錄名 20230219 跟內容無關。
# 同層還有 `Cheng🏂`、`iPhone培` 這種完全沒有日期的目錄名。檔名才可信。
# 也不能用 mtime 兜底：那是 FTP 搬檔時間，不是拍攝時間。
# 例：SCAN_HOME_DIRS=手機照片,DCIM
SCAN_HOME_DIRS=

# ---- 相片庫 ----
# 掃描時會把 LIBRARY_ROOTS 底下的圖片一併收進相片庫。
# MIN_FILE_MB 是給影片用的（預設 50MB），套在圖片上會把全部濾掉，
# 所以圖片另外用這個 KB 級門檻，擋掉圖示與版面小圖。
MIN_PHOTO_KB=40
# 超過這個大小的圖片不讀，避免一張掃描檔把記憶體吃光
MAX_PHOTO_MB=80
# 影片資料夾裡的海報／劇照不要收進相片庫。
# poster.jpg、fanart.jpg、cover.png 這類固定檔名，以及跟同資料夾影片同名的圖
# （「玩命關頭.mkv」旁邊的「玩命關頭.jpg」）都會被跳過。
# 關掉的話點「相片」會看到一整牆的影片封面。
PHOTO_EXCLUDE_VIDEO_ARTWORK=true
# 點圖放大時載入的衍生圖長邊像素。原圖中位數 2MB、最大 30MB，
# 每開一次燈箱就從 FTP 重拉原圖是真正的瓶頸（不是有沒有縮放）。
# 放大到超過這個像素時前端會自己換成原圖。
PHOTO_PREVIEW_PX=1920
# 掃描時同時探測影片資訊的併發數
PROBE_CONCURRENCY=3
# 啟動時自動掃描
AUTO_SCAN_ON_START=false
# 開發用：改動 app/ 底下的程式時自動重啟服務（不用手動 Ctrl+C 再啟動一次）
DEV_RELOAD=false

# ---------------------------------------------------------------- 字幕
# 內嵌字幕要把整部片 demux 一遍才收得齊，大檔案動輒幾十秒。
# 開著的話播放器會在開播幾秒後於背景先抽好放進快取（來源檔沒換過就一直有效），
# 按下字幕時不用等。延後幾秒是刻意的：抽字幕會跟影片本身的串流搶同一條 FTP。
# 幾乎不看字幕的話關掉，可以省下那一次整片 demux。
SUBTITLE_PREFETCH=true
